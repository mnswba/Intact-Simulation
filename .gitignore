!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Checked-in configuration example contains no secrets.
!.env.example

# Python backend environment and local engineering outputs
backend/.venv/
**/__pycache__/
**/.pytest_cache/
backend/.env
backend/.state/
!backend/.env.example

# Local Python/engineering state, downloaded binaries and private publication staging
.venv/
.state/
*.sqlite3
*.sqlite3-*
*.log
*.AppImage
*.deb
*.zip
.openai/

# Local PicoGK bridge build outputs
backend/picogk/bin/
backend/picogk/obj/

